{
	"typescript.tsdk": "node_modules/typescript/lib",
	"files.eol": "\n",
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"eslint.run": "onType",
	"eslint.validate": [
		"typescript",
		"typescriptreact"
	],
	"editor.formatOnPaste": true,
	"editor.formatOnType": true,
}
